# ==============================================================================
# K-PANEL DISPOSABLE STAGING SMOKE-TEST CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT SECURITY & ISOLATION CONSTRAINTS:
# 1. NON-SECRET CONFIGURATION ONLY: Do NOT put database passwords, session secrets,
#    or GitHub private keys here. Staging smoke tests are completely stateless.
# 2. UNIQUE PROJECT NAME: Must be unique per test execution (e.g. kpanel-smoke-20261023).
#    Never use 'kpanel', 'kpanel-clean', 'dokploy', or 'n8n'.
# 3. LOOPBACK INGRESS PORT: Must be verified unreserved high port (>= 1024).
#    Default is 18080. Strictly bound to 127.0.0.1.
# ==============================================================================

# Unique Compose project namespace for isolated lifecycle management
COMPOSE_PROJECT_NAME=kpanel-smoke-demo

# Unique smoke-test run identifier used to namespace resource labels
SMOKE_RUN_ID=smoke-run-demo

# Staging ingress port on host IPv4 loopback (127.0.0.1:<port>)
# Operator must verify this port is unoccupied on host before execution
STAGING_INGRESS_PORT=18080

# Fixed internal target application HTTP port (fixed to 8080 across candidate, ingress,
# healthcheck, and Compose configuration for disposable staging smoke testing)
APP_PORT=8080

# ------------------------------------------------------------------------------
# Pinned Immutable Image References (ARM64 / Multi-Arch Compatible)
# ------------------------------------------------------------------------------
# NOTE: Placeholder digests below are offline fixtures for configuration validation.
# For future authorized execution, pin to verified multi-arch digests.
CANDIDATE_IMAGE=node:20-alpine@sha256:d83935dbd03ad4320267f53a4e9b9c02ff5675e206b864819ad18b76e2794c16
INGRESS_IMAGE=nginxinc/nginx-unprivileged:alpine@sha256:39f88c644265637fae94be7bfcae27f0dd3a7c6f065360980cff3d6a2f3b97b0
